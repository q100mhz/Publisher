# Скопируйте в .env и заполните:  cp .env.example .env

# Пользователи регистрируются сами по e-mail или создаются из терминала:
#   docker compose exec app python -m app.cli add-user <логин>

# Длинная случайная строка для подписи cookie. Сгенерировать:  openssl rand -hex 32
SECRET_KEY=

# true — если сайт открывается по https (рекомендуется)
COOKIE_SECURE=true

# --- База данных ---
# Любой длинный пароль. Сгенерировать:  openssl rand -hex 16
POSTGRES_PASSWORD=

# --- Нейросеть ---
# Базовый ключ DeepSeek сервиса. Им пользуются только те, кому вы разрешили это в админке,
# и только пока у пользователя нет своего ключа DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Регистрация и админка ---
# Регистрация по e-mail на странице входа (false — выключить)
REGISTRATION_ENABLED=true
# Адрес админки: только на нём открывается /admin
ADMIN_HOST=publisher-admin.itb2bhost.ru
# Администраторы создаются из терминала:  docker compose exec app python -m app.cli add-admin <логин>

# --- Сайт ---
BASE_PATH=/publisher
# Порт на сервере, на который nginx проксирует /publisher/
APP_PORT=8090

# --- Парсер (можно не менять) ---
AUTO_PARSE_INTERVAL_HOURS=4
# Пауза между запросами к одному сайту, секунды
PARSER_DELAY_MIN=2
PARSER_DELAY_MAX=5
PARSER_FIRST_RUN_LIMIT=5
PARSER_MAX_PER_RUN=30
PARSER_USE_BROWSER=true

# --- Сборка ---
# Зеркало PyPI, если pypi.org с сервера недоступен, например:
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
# MTU сети Docker: должен быть не больше MTU сервера (команда: ip -br link). Обычно 1500, на некоторых VPS 1450 или 1400
DOCKER_MTU=1500
