# Скопируйте в .env и заполните:  cp .env.example .env

# --- Вход в систему ---
# Пользователь создаётся при ПЕРВОМ запуске. После первого входа строку ADMIN_PASSWORD можно удалить.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Длинная случайная строка для подписи cookie. Сгенерировать:  openssl rand -hex 32
SECRET_KEY=

# true — если сайт открывается по https (рекомендуется)
COOKIE_SECURE=true

# --- База данных ---
# Любой длинный пароль. Сгенерировать:  openssl rand -hex 16
POSTGRES_PASSWORD=

# --- DeepSeek ---
# Ключ: https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Сайт ---
BASE_PATH=/publisher
# Порт на сервере, на который nginx проксирует /publisher/
APP_PORT=8090

# --- Парсер (можно не менять) ---
AUTO_PARSE_INTERVAL_HOURS=4
# Пауза между запросами к одному сайту, секунды
PARSER_DELAY_MIN=2
PARSER_DELAY_MAX=5
PARSER_FIRST_RUN_LIMIT=5
PARSER_MAX_PER_RUN=30
PARSER_USE_BROWSER=true

# --- Сборка ---
# Зеркало PyPI, если pypi.org с сервера недоступен, например:
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
